# Crossfeed 环境变量（复制为 .env.local 后按需填写）
# 只认 CROSSFEED_*，没有旧名兼容。

CROSSFEED_HOST=0.0.0.0
CROSSFEED_PORT=4000

# CROSSFEED_CORS_ORIGINS=*
# CROSSFEED_WEB_ROOT=
# CROSSFEED_OPENCLI_BIN=
# CROSSFEED_FEED_TTL_SECONDS=18000
# CROSSFEED_DATA_DIR=./data
# CROSSFEED_DB_PATH=

# LLM（OpenAI 兼容 /v1/chat/completions，含 MiniMax、DeepSeek 等）
# CROSSFEED_LLM_API_KEY=
# CROSSFEED_LLM_BASE_URL=https://api.openai.com/v1
# CROSSFEED_LLM_MODEL=gpt-4o-mini

# 浏览器类 Adapter 默认后台窗口；设 0 则前台
# CROSSFEED_OPENCLI_MUTED=1
